# My Shop — environment template.
#
# Master Plan §13.6: only placeholders are committed. `.env` is git-ignored.
# No value below is a real credential, and none may be replaced with one here.

# --- Backend runtime ---
NODE_ENV=development
PORT=3000

# --- Database ---
# M1-S3 introduces Prisma and two roles (Master Plan §13.4):
#   migrator     — DDL + DML, migration jobs only
#   application  — DML only, subject to FORCE ROW LEVEL SECURITY, never BYPASSRLS
# Replace <...> locally. Never commit a real connection string.
DATABASE_URL="postgresql://<app_user>:<app_password>@<host>:5432/<database>?schema=public"
MIGRATION_DATABASE_URL="postgresql://<migrator_user>:<migrator_password>@<host>:5432/<database>?schema=public"
# Privileged maintenance connection for role provisioning (`npm run db:bootstrap`)
# and the test-database lifecycle only. The application never reads it.
ADMIN_DATABASE_URL="postgresql://<admin_user>:<admin_password>@<host>:5432/postgres?schema=public"

# The acceptance suite (`npm test`) drives a fixed database named `my_shop_test`
# and refuses to run unless DATABASE_URL and MIGRATION_DATABASE_URL both name it,
# so a test run can never drop or migrate a development or production database.

# --- Identity (§10.2, §10.3) ---
# Asymmetric signing material for access tokens, supplied by a secret manager in
# every non-local environment. Both values are **base64 of PEM text**, decoded once
# at startup; the local-development placeholder below is not a key. The pair is
# required in production and optional elsewhere, where an absent pair leaves the
# authentication surface fail-closed rather than open.
JWT_PRIVATE_KEY="<development-only-placeholder>"
JWT_PUBLIC_KEY="<development-only-placeholder>"
JWT_ISSUER=my-shop
JWT_AUDIENCE=my-shop-client
ACCESS_TOKEN_TTL_SECONDS=900

# Server-side session lifetimes. A session is one login (the refresh-token family):
# it idles out after REFRESH_IDLE_TTL_SECONDS and dies absolutely after
# REFRESH_ABSOLUTE_TTL_SECONDS regardless of use.
REFRESH_IDLE_TTL_SECONDS=604800
REFRESH_ABSOLUTE_TTL_SECONDS=2592000

# Argon2id parameters (§10.2): explicit, never the library's defaults, so cost can be
# raised without a code change. ARGON2_MEMORY_KIB has a floor of 8192.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Password policy (§10.2): minimum length plus a denial-of-service ceiling. There are
# deliberately no composition rules.
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Failed-attempt backoff (§10.2): the first AUTH_THROTTLE_FREE_ATTEMPTS failures do not
# block; the delay then doubles from AUTH_THROTTLE_BASE_DELAY_SECONDS up to
# AUTH_THROTTLE_MAX_DELAY_SECONDS. Bounded by construction — never a permanent lockout.
AUTH_THROTTLE_FREE_ATTEMPTS=5
AUTH_THROTTLE_BASE_DELAY_SECONDS=1
AUTH_THROTTLE_MAX_DELAY_SECONDS=900

# Operator credential provisioning (§10.2, §10.4), read ONLY by
# `npm run provision:credential --workspace @my-shop/api`. The password is taken from
# `PROVISION_PASSWORD` in the environment and is never accepted as a command-line
# argument and never printed. Set it for the single invocation and unset it afterwards.
# PROVISION_PASSWORD="<the password to set for the named user>"

# --- Offline grace (§22.4, O-20) ---
# Owner-controlled window bounding offline authorization. Default 72 hours.
# Maximum 30 days. A snapshot signature key, supplied by a secret manager.
OFFLINE_GRACE_DURATION_HOURS=72
OFFLINE_GRACE_SIGNING_KEY="<development-only-placeholder>"

# --- Device registration (§12) ---
DEVICE_IDENTITY_SIGNING_KEY="<development-only-placeholder>"

# --- Observability (§38.28.3) ---
# Structured JSON logs, redacted by construction.
LOG_LEVEL=info