{
  "name": "@my-shop/api",
  "version": "0.1.0",
  "private": true,
  "description": "My Shop backend API - the sole authority for every business invariant (Master Plan section 7.3).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "start": "node dist/main.js",
    "start:dev": "node --watch dist/main.js",
    "typecheck": "tsc --build && npm run typecheck:test",
    "typecheck:solo": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:database": "jest --selectProjects database",
    "test:cov": "jest --coverage",
    "db:migrate": "node scripts/db.mjs",
    "db:bootstrap": "node scripts/db.mjs bootstrap",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@my-shop/contracts": "0.1.0",
    "@my-shop/testkit": "0.1.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.12.0",
    "body-parser": "2.3.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "prisma": "6.12.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
