{
  "name": "@my-shop/api",
  "version": "0.1.0",
  "private": true,
  "description": "My Shop backend API - the sole authority for every business invariant (Master Plan section 7.3).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "start": "node dist/main.js",
    "typecheck": "tsc --build",
    "typecheck:solo": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@my-shop/contracts": "0.1.0",
    "@my-shop/testkit": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}